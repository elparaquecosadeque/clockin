meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    const body = res.getBody();
    bru.setVar("accessToken", body.accessToken);
    const serverNow = new Date(Date.parse(body.expiresAt) - 15 * 60 * 1000);
    const parts = Object.fromEntries(new Intl.DateTimeFormat("en", {
      timeZone: "America/Bogota", year: "numeric", month: "2-digit", day: "2-digit"
    }).formatToParts(serverNow).map(p => [p.type, p.value]));
    const day = new Date(`${parts.year}-${parts.month}-${parts.day}T00:00:00Z`);
    day.setUTCDate(day.getUTCDate() - ((day.getUTCDay() + 6) % 7) - 7);
    bru.setVar("weekStart", day.toISOString().slice(0, 10));
  } else {
    bru.deleteVar("accessToken");
  }
}

tests {
  test("Signed in", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().accessToken).to.be.a("string");
  });
}
