meta {
  name: Login Ada
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{demoPassword}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("adminToken", res.getBody().accessToken);
  } else {
    bru.deleteVar("adminToken");
  }
}

tests {
  test("Expected status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
