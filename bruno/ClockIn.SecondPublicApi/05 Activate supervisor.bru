meta {
  name: Activate supervisor
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/set-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{activationToken}}",
    "password": "{{newPassword}}"
  }
}

tests {
  test("Expected status 204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}
