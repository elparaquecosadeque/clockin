  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{supervisorEmail}}",
    "name": "Bruno Supervisor",
    "role": "Supervisor",
    "teamId": null
  }
}

tests {
  test("Expected status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
