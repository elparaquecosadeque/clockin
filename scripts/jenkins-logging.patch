diff --git a/telemetry/setup-clockin-logs.sh b/telemetry/setup-clockin-logs.sh
new file mode 100644
--- /dev/null
+++ b/telemetry/setup-clockin-logs.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")/.."
+set -a
+. ./.env
+set +a
+: "${CLOCKIN_LOGGING_PASSWORD:?set CLOCKIN_LOGGING_PASSWORD}"
+[[ "$CLOCKIN_LOGGING_PASSWORD" =~ ^[a-f0-9]{64}$ ]] || { echo 'Expected generated hex logging password' >&2; exit 1; }
+docker exec -i shared-postgres psql -U telemetry -d telemetry -v ON_ERROR_STOP=1 -q < telemetry/schema.sql
+DB_PASSWORD="$CLOCKIN_LOGGING_PASSWORD" docker exec -i -e DB_PASSWORD shared-postgres psql -U postgres -d telemetry -v ON_ERROR_STOP=1 -q <<'SQL'
+\getenv pw DB_PASSWORD
+SELECT 'CREATE ROLE clockin_log_writer LOGIN' WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'clockin_log_writer')\gexec
+SELECT format('ALTER ROLE clockin_log_writer PASSWORD %L', :'pw')\gexec
+GRANT CONNECT ON DATABASE telemetry TO clockin_log_writer;
+GRANT USAGE ON SCHEMA public TO clockin_log_writer;
+REVOKE ALL ON clockin_logs FROM PUBLIC;
+REVOKE ALL ON clockin_logs FROM clockin_log_writer;
+GRANT INSERT ON clockin_logs TO clockin_log_writer;
+SQL
+echo '==> ClockIn log table, read-only Grafana access and INSERT-only writer ready'
