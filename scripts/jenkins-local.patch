diff --git a/casc/jenkins.yaml b/casc/jenkins.yaml
--- a/casc/jenkins.yaml
+++ b/casc/jenkins.yaml
@@ -50,6 +50,16 @@ credentials:
               id: todo-list-db-password
               description: "todo-list: Postgres password"
               secret: "${TODO_LIST_DB_PASSWORD}"
+          - string:
+              scope: GLOBAL
+              id: clockin-postgres-password
+              description: "ClockIn: dedicated Postgres password"
+              secret: "${CLOCKIN_POSTGRES_PASSWORD}"
+          - string:
+              scope: GLOBAL
+              id: clockin-signing-key-base64
+              description: "ClockIn: base64-encoded P-256 PEM signing key"
+              secret: "${CLOCKIN_SIGNING_KEY_BASE64}"

 jobs:
   # One pipeline job per app, all in the "apps" folder: that folder is the single dashboard.
@@ -58,6 +68,7 @@ jobs:
       def apps = [
         [name: 'worktime', repo: '${WORKTIME_REPO_URL}', branch: 'main', description: 'Worktime: horas en tiempo real (Angular + .NET + SignalR)'],
         [name: 'todo-list', repo: 'https://github.com/elparaquecosadeque/todo-list-docker.git', branch: 'master', description: 'To-do list POC (Node + Postgres), puerto 3000'],
+        [name: 'clockin', repo: 'https://github.com/elparaquecosadeque/clockin', branch: 'main', description: 'ClockIn: Angular + .NET, shared PostgreSQL, port 8082'],
       ]

       folder('apps') {
@@ -68,10 +79,15 @@ jobs:
       apps.each { app ->
         pipelineJob("apps/" + app.name) {
+          disabled(app.name == 'clockin' && !'${CLOCKIN_DEPLOY_ENABLED:-false}'.toBoolean())
           description(app.description)
           logRotator { numToKeep(30) }
           // Declared here too (not only in the Jenkinsfile): JCasC regenerates the job on every restart, and
           // without this the rollback parameter would vanish until the next build re-registered it.
           parameters {
+            if (app.name == 'clockin') {
+              stringParam('FIRST_ADMIN_EMAIL', '', 'Required production admin email')
+              booleanParam('ACK_SCHEMA_COMPATIBLE', false, 'Rollback: confirm target images support the current schema')
+            }
             stringParam('DEPLOY_TAG', '', 'Vacío: probar, construir y desplegar el último commit. Un tag existente (p. ej. 12-a1b2c3d): rollback sin construir.')
           }
           properties {
diff --git a/.env.example b/.env.example
--- a/.env.example
+++ b/.env.example
@@ -31,2 +31,7 @@
 GRAFANA_DB_PASSWORD=change-me
 GRAFANA_ADMIN_PASSWORD=change-me
+
+# --- ClockIn --- generated by ClockIn scripts/configure-jenkins.sh
+CLOCKIN_POSTGRES_PASSWORD=replace-with-generated-64-character-hex-password
+CLOCKIN_SIGNING_KEY_BASE64=replace-with-base64-encoded-p256-pem
+CLOCKIN_DEPLOY_ENABLED=false
