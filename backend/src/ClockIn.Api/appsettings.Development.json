{
  "Serilog": {
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/app-.log", "rollingInterval": "Day" } }
    ]
  },
  "Database": {
    "Provider": "SQLite",
    "ConnectionString": "Data Source=clockin.dev.db",
    "MigrateOnStartup": true
  },
  "FirstAdmin": {
    "Email": "admin@clockin.local"
  },
  "Demo": {
    "Enabled": true
  }
}
