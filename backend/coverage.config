<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*ClockIn\.(Api|PublicApi|SecondPublicApi|Hosting|Application|Domain|Infrastructure|Persistence)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[/\\]obj[/\\].*</Source>
        <Source>.*[/\\]genai[/\\].*</Source>
      </Exclude>
    </Sources>
    <IncludeTestAssembly>False</IncludeTestAssembly>
  </CodeCoverage>
</Configuration>
