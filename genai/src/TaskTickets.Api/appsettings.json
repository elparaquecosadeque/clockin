{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Auth": {
    "Issuer": "TaskTickets",
    "Audience": "TaskTickets.Client",
    "LifetimeMinutes": 30
  },
  "AuthRateLimit": {
    "PerIp": 10,
    "Global": 100,
    "WindowSeconds": 60
  }
}
